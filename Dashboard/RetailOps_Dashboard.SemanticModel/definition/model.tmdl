model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Geography","Inventory","OrderItems","Orders","payments","Products","Returns","sales","Shipments","_Measures","DataFolder","Customers","Reviews","WebTraffic","Promotions"]

ref table Date
ref table Geography
ref table Inventory
ref table OrderItems
ref table Orders
ref table 'Overstock Days Threshold'
ref table payments
ref table Products
ref table 'Return Date'
ref table Returns
ref table sales
ref table Shipments
ref table 'SLA Days'
ref table 'Stockout Days Threshold'
ref table _Measures
ref table Customers
ref table 'Review Date'
ref table Reviews
ref table WebTraffic
ref table Promotions

ref cultureInfo en-US

