table Returns
	lineageTag: 34331938-33c9-4808-b528-dd7ace8d4391

	column return_id
		dataType: string
		isHidden
		lineageTag: c4e1ab85-b708-4786-9c46-1b1a987d6d3a
		summarizeBy: none
		sourceColumn: return_id

	column order_id
		dataType: int64
		isHidden
		lineageTag: c8a00590-190c-4104-964f-f7791879fa83
		summarizeBy: none
		sourceColumn: order_id

	column product_id
		dataType: int64
		isHidden
		lineageTag: 74d31b03-ad45-4ccd-a21f-026382dd7445
		summarizeBy: none
		sourceColumn: product_id

	column return_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: eb2641ff-31fd-45b3-9c85-c9047154cfbc
		summarizeBy: none
		sourceColumn: return_date

		annotation UnderlyingDateTimeDataType = Date

	column return_reason
		dataType: string
		lineageTag: 49c75d19-10b0-429f-8ad0-3755f0836314
		summarizeBy: none
		sourceColumn: return_reason

	column return_quantity
		dataType: int64
		formatString: #,0
		lineageTag: f8172f36-0aee-4408-86ce-a81d92de315e
		summarizeBy: sum
		sourceColumn: return_quantity

	column refund_amount
		dataType: double
		formatString: #,0.00
		lineageTag: dfcf1d09-a7a2-4c44-8022-5501cd8993fc
		summarizeBy: sum
		sourceColumn: refund_amount

	column days_to_return = DATEDIFF(RELATED(Orders[order_date]), Returns[return_date], DAY)
		dataType: int64
		formatString: 0
		lineageTag: 9745aa3d-faf4-4a55-84e7-03950d6d49c6
		summarizeBy: none

	partition Returns = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\returns.csv"), [Delimiter=",", Encoding=65001]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"return_id", type text}, {"order_id", Int64.Type}, {"product_id", Int64.Type}, {"return_date", type date}, {"return_reason", type text}, {"return_quantity", Int64.Type}, {"refund_amount", type number}}, "en-US")
				in
					Typed

