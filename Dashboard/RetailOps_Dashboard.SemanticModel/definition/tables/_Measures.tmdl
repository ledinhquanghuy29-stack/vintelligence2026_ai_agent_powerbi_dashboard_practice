	measure 'Promo Campaigns Started' =
			VAR Yrs = VALUES('Date'[Year])
			RETURN COUNTROWS(FILTER(Promotions, YEAR(Promotions[start_date]) IN Yrs))
		formatString: #,0
		displayFolder: Sales
		lineageTag: 85a2eb37-577b-48e0-b498-35564fb66998

	measure 'Gross Margin % by Promo Band' =
			VAR MinS = MIN('Promo Share Band'[Min Share])
			VAR MaxS = MAX('Promo Share Band'[Max Share])
			VAR BandMonths =
				FILTER(
					VALUES('Date'[Month Start]),
					VAR s = [Promo Revenue Share %]
					RETURN NOT ISBLANK(s) && s >= MinS && s < MaxS
				)
			RETURN CALCULATE([Gross Margin %], BandMonths)
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 6f9a2c84-3e1b-4d75-a8c6-0b4e7d2f9a16

