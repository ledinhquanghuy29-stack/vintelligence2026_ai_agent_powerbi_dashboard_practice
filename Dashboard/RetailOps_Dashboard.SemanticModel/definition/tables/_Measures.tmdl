							&& NOT ISBLANK(CALCULATE([Net Revenue], 'Date'[Year] = PrevYear))
					)
				VAR N = COUNTROWS(Months)
				VAR CurVal = CALCULATE([Review Count], 'Date'[Year] = CurYear, Months)
				VAR PrevVal = CALCULATE([Review Count], 'Date'[Year] = PrevYear, Months)
				VAR Period = " (" & CurYear & " vs " & PrevYear & IF(N < 12, ", " & N & " mo", "") & ")"
				VAR Delta = DIVIDE(CurVal - PrevVal, PrevVal)
				RETURN
					IF(
						N = 0 || ISBLANK(PrevVal) || PrevVal = 0,
						"No " & PrevYear & " data to compare",
						IF(Delta >= 0, "🟢 ", "🔴 ") & IF(Delta >= 0, "▲ ", "▼ ") & FORMAT(ABS(Delta), "0.0%") & Period
					)
			```
		displayFolder: Comparisons
		lineageTag: 5e932f30-bb89-4d4b-99e3-b56b883833d9

	measure 'Positive Review % YoY Label' = ```
				VAR CurYear = MAX('Date'[Year])
				VAR PrevYear = CurYear - 1
				VAR Months =
					FILTER(
						CALCULATETABLE(VALUES('Date'[Month Number]), 'Date'[Year] = CurYear),
						NOT ISBLANK(CALCULATE([Net Revenue], 'Date'[Year] = CurYear))
							&& NOT ISBLANK(CALCULATE([Net Revenue], 'Date'[Year] = PrevYear))
					)
				VAR N = COUNTROWS(Months)
				VAR CurVal = CALCULATE([Positive Review %], 'Date'[Year] = CurYear, Months)
				VAR PrevVal = CALCULATE([Positive Review %], 'Date'[Year] = PrevYear, Months)
				VAR Period = " (" & CurYear & " vs " & PrevYear & IF(N < 12, ", " & N & " mo", "") & ")"
				VAR Delta = CurVal - PrevVal
				RETURN
					IF(
						N = 0 || ISBLANK(PrevVal),
						"No " & PrevYear & " data to compare",
						IF(Delta >= 0, "🟢 ", "🔴 ") & IF(Delta >= 0, "▲ ", "▼ ") & FORMAT(ABS(Delta) * 100, "0.0") & " pts" & Period
					)
			```
		displayFolder: Comparisons
		lineageTag: a169f0a5-79ec-4a85-9569-ad6205d6caf9

