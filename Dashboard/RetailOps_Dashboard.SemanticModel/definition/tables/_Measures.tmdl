		formatString: 0.00%
		displayFolder: Web Traffic
		lineageTag: 391257bc-3dae-4855-b6db-a7c92b698f29

	measure 'Net Revenue YoY Label' = ```
				VAR CurYear = MAX('Date'[Year])
				VAR PrevYear = CurYear - 1
				VAR Months =
					FILTER(
						CALCULATETABLE(VALUES('Date'[Month Number]), 'Date'[Year] = CurYear),
						NOT ISBLANK(CALCULATE([Net Revenue], 'Date'[Year] = CurYear))
							&& NOT ISBLANK(CALCULATE([Net Revenue], 'Date'[Year] = PrevYear))
					)
				VAR N = COUNTROWS(Months)
				VAR CurVal = CALCULATE([Net Revenue], 'Date'[Year] = CurYear, Months)
				VAR PrevVal = CALCULATE([Net Revenue], 'Date'[Year] = PrevYear, Months)
				VAR Pct = DIVIDE(CurVal - PrevVal, PrevVal)
				VAR Period = " (" & CurYear & " vs " & PrevYear & IF(N < 12, ", " & N & " mo", "") & ")"
				RETURN
					IF(
						N = 0 || ISBLANK(PrevVal) || PrevVal = 0,
						"No " & PrevYear & " data to compare",
						IF(Pct >= 0, "🟢 ▲ ", "🔴 ▼ ") & FORMAT(ABS(Pct), "0.0%") & Period
					)
			```
		displayFolder: Comparisons
		lineageTag: a1b2c3d4-0001-4aaa-9001-000000000001

	measure 'Gross Margin % YoY Label' = ```
				VAR CurYear = MAX('Date'[Year])
				VAR PrevYear = CurYear - 1
				VAR Months =
					FILTER(
						CALCULATETABLE(VALUES('Date'[Month Number]), 'Date'[Year] = CurYear),
						NOT ISBLANK(CALCULATE([Net Revenue], 'Date'[Year] = CurYear))
							&& NOT ISBLANK(CALCULATE([Net Revenue], 'Date'[Year] = PrevYear))
					)
				VAR N = COUNTROWS(Months)
				VAR CurVal = CALCULATE([Gross Margin %], 'Date'[Year] = CurYear, Months)
				VAR PrevVal = CALCULATE([Gross Margin %], 'Date'[Year] = PrevYear, Months)
				VAR Diff = CurVal - PrevVal
				VAR Period = " (" & CurYear & " vs " & PrevYear & IF(N < 12, ", " & N & " mo", "") & ")"
				RETURN
					IF(
						N = 0 || ISBLANK(PrevVal),
						"No " & PrevYear & " data to compare",
						IF(Diff >= 0, "🟢 ▲ ", "🔴 ▼ ") & FORMAT(ABS(Diff) * 100, "0.0") & " pts" & Period
					)
			```
		displayFolder: Comparisons
		lineageTag: a1b2c3d4-0002-4aaa-9002-000000000002

	measure 'Delivered Within SLA % Status Label' = ```
				VAR CurVal = [Delivered Within SLA %]
				RETURN
					IF(
						ISBLANK(CurVal),
						"No data",
						IF(CurVal >= 0.95, "🟢 On target (≥95%)", "🔴 Below target (≥95%)")
					)
			```
		displayFolder: Comparisons
		lineageTag: a1b2c3d4-0003-4aaa-9003-000000000003

	measure 'Return Rate % Status Label' = ```
