	measure 'Ending Stock Value' =
			VAR d = MAX(Inventory[snapshot_date])
			RETURN CALCULATE(SUM(Inventory[Stock Value]), Inventory[snapshot_date] = d)
		formatString: $#,0
		displayFolder: Inventory
		lineageTag: 9b3e6f21-4c7a-4d85-a1f0-3e8b2c5d7f64

	measure 'Gross Margin % (Rolling 12M)' =
			VAR LastD = MAX('Date'[Date])
			VAR WinStart = EOMONTH(LastD, -12) + 1
			VAR FirstData = CALCULATE(MIN(Orders[order_date]), REMOVEFILTERS())
			RETURN
				IF(
					WinStart >= DATE(YEAR(FirstData), MONTH(FirstData), 1),
					CALCULATE([Gross Margin %], REMOVEFILTERS('Date'), DATESINPERIOD('Date'[Date], LastD, -12, MONTH))
				)
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 4b8e2d61-9c3a-4f7e-a5d2-1e6c8b3f9a70

	measure 'Median Days of Supply (Rolling 12M)' =
			VAR LastD = MAX('Date'[Date])
			VAR WinStart = EOMONTH(LastD, -12) + 1
			VAR FirstData = CALCULATE(MIN(Inventory[snapshot_date]), REMOVEFILTERS())
			RETURN
				IF(
					WinStart >= DATE(YEAR(FirstData), MONTH(FirstData), 1),
					CALCULATE([Median Days of Supply], REMOVEFILTERS('Date'), DATESINPERIOD('Date'[Date], LastD, -12, MONTH))
				)
		formatString: #,0
		displayFolder: Inventory
		lineageTag: 2a9d6e14-8b3c-4f51-9e72-5c0a1d8b4f36

