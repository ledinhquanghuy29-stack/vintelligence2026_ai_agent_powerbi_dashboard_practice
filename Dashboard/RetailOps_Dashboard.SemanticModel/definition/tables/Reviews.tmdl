		summarizeBy: none
		sourceColumn: review_title

	partition Reviews = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\reviews.csv"), [Delimiter=",", Encoding=65001]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"review_id", type text}, {"order_id", Int64.Type}, {"product_id", Int64.Type}, {"customer_id", Int64.Type}, {"review_date", type date}, {"rating", Int64.Type}, {"review_title", type text}}, "en-US")
				in
					Typed

